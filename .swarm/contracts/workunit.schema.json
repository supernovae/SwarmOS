{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/supernovae/swarmos/schemas/workunit.schema.json",
  "title": "SwarmOS WorkUnit Contract",
  "type": "object",
  "required": ["id", "objective", "constraints", "acceptance", "workflow"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflow": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor"]
    },
    "gate": {
      "type": "string",
      "enum": ["", "none", "agent", "human"]
    },
    "allow_harness_changes": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
