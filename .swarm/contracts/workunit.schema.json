{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/supernovae/swarmos/schemas/workunit.schema.json",
  "title": "SwarmOS WorkUnit Contract",
  "type": "object",
  "required": ["id", "objective", "constraints", "acceptance", "workflow"],
  "properties": {
    "base_branch": {"type": "string"},
    "size": {"type": "string", "enum": ["", "small", "multi_area"]},
    "uncertainty": {"type": "string", "enum": ["", "known", "unknown"]},
    "risk": {"type": "string", "enum": ["", "standard", "sensitive", "urgent"]},
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 0
    },
    "parent_issue": {
      "type": "integer",
      "minimum": 0
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "constraints": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflow": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor"]
    },
    "gate": {
      "type": "string",
      "enum": ["", "none", "agent", "human"]
    },
    "allow_harness_changes": {
      "type": "boolean"
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
